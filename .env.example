# OddsIQ configuration. Copy to .env and fill in what you need:
#   cp .env.example .env
# Only ODDS_API_KEY is required. Everything else shows its default value and
# can stay commented out. Never commit .env.

# --- Required ----------------------------------------------------------------

# The Odds API key, used for both Pinnacle odds and schedules/scores.
ODDS_API_KEY=your-odds-api-key

# --- Core --------------------------------------------------------------------

# Day of the month your Odds API quota resets (the budget governor plans around it).
# ODDS_API_QUOTA_RESET_DAY=1
# 1 = scrape Tipsport (the only soft bookmaker); 0 = Pinnacle only, no edge detection.
# BOOKMAKER_TIPSPORT_ENABLED=1

# --- Telegram (sent only for real-money events: bet placed, won/lost) --------

# Bot token from @BotFather. Leave empty to disable Telegram.
# TELEGRAM_BOT_TOKEN=123456789:your-bot-token
# Chat that receives the messages.
# TELEGRAM_CHAT_ID=123456789
# Optional second recipient; both values of the pair must be set.
# TELEGRAM_BOT_TOKEN_2=
# TELEGRAM_CHAT_ID_2=

# --- Monitoring --------------------------------------------------------------

# Dead-man ping URL (healthchecks.io style), requested on every heartbeat.
# HEARTBEAT_PING_URL=https://hc-ping.example/your-check-id

# --- Detection ---------------------------------------------------------------

# Minimum edge over the vig-free Pinnacle price to record a value bet (fraction).
# EDGE_THRESHOLD=0.03
# Edges at or above this are stamped as implausible stale prices (<=0 disables).
# PREGAME_MAX_PLAUSIBLE_EDGE=0.08
# Tipsport two-way implied sum below this marks the market incoherent (<=0 disables).
# PREGAME_MIN_BOOK_OVERROUND=1.0
# Maximum age of Pinnacle's upstream last_update before a detection is excluded.
# PREGAME_MAX_SHARP_SOURCE_AGE_SECONDS=300
# 1 = exclude edges from a Tipsport listing that lacks one side of its market.
# PREGAME_REQUIRE_COMPLETE_BOOK_MARKET=1
# Snapshots older than this before kickoff are not used as closing lines.
# CLOSING_FRESHNESS_MINUTES=30
# Pinnacle markets to fetch; detection is moneyline-only.
# PINNACLE_MARKETS=h2h

# --- Polling and schedule (seconds) ------------------------------------------

# Schedule refresh while a sport has a game in the polling window.
# SCHEDULE_GAME_WINDOW_REFRESH=900
# Cadence of the game-final check that triggers settlement.
# SCHEDULE_COMPLETION_CHECK_INTERVAL=900
# Full sweep across all enabled sports to discover new games.
# SCHEDULE_REFRESH_INTERVAL=10800
# Cadence of the heartbeat log line (and the dead-man ping).
# SCHEDULER_HEARTBEAT_SECONDS=60

# --- Budget governor ---------------------------------------------------------

# Remaining-quota floor below which Pinnacle polling is throttled.
# BUDGET_RESERVE_FLOOR=1500
# Projected-overshoot slack tolerated before throttling.
# BUDGET_THROTTLE_SLACK=1.10

# --- Auto-betting (off by default; see DEPLOY.md before enabling) ------------

# Master switch for the betting engine. Also needs a bridge token, arming and
# a connected browser extension before anything is placed.
# BETTING_ENABLED=0
# Shared secret between the pipeline bridge and the browser extension.
# BETTING_BRIDGE_TOKEN=generate-a-long-random-secret
# Bridge bind address and port (the compose file overrides the host).
# BETTING_BRIDGE_HOST=127.0.0.1
# BETTING_BRIDGE_PORT=8765
# 1 = the extension clicks the final submit button. Keep 0 for dry runs.
# BETTING_CONFIRM_ENABLED=0
# Seconds to wait for a placement result; must exceed the extension's waits.
# BETTING_PLACEMENT_TIMEOUT_SECONDS=60
# Hard ceilings that clamp the runtime knobs stored in the database.
# BETTING_MAX_STAKE_CZK=500
# BETTING_MAX_BETS_PER_DAY=10
# BETTING_MAX_OPEN_STAKES_CZK=500
# BETTING_MAX_DAILY_LOSS_CZK=300
# Maximum age of the fair price at dispatch time.
# BETTING_FAIR_MAX_AGE_SECONDS=120
# No bets closer than this to kickoff.
# BETTING_TIPOFF_BUFFER_SECONDS=120
# Password for the actuator container's loopback VNC server (one-time login).
# VNC_PASSWORD=choose-a-throwaway-password

# --- Dashboard write controls ------------------------------------------------

# 1 = show arm/disarm and stake controls. Requires both credentials below.
# DASHBOARD_CONTROLS_ENABLED=0
# Basic-auth credentials for the money-affecting POST endpoints.
# DASHBOARD_CONTROLS_USERNAME=your-username
# DASHBOARD_CONTROLS_PASSWORD=generate-a-long-random-secret

# --- Storage and retention ---------------------------------------------------

# SQLite database file.
# DATABASE_PATH=./oddsiq.db
# Archive of raw API responses.
# RAW_DATA_DIR=./data/raw
# Database backups on startup, shutdown and every BACKUP_INTERVAL_HOURS (<=0 disables periodic).
# BACKUP_ENABLED=1
# BACKUP_INTERVAL_HOURS=24
# BACKUP_DIR=./backups
# Number of daily and monthly backups to keep.
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_MONTHLY=6
# Prune raw responses older than RAW_RESPONSE_KEEP_DAYS.
# RAW_RESPONSE_RETENTION_ENABLED=1
# RAW_RESPONSE_KEEP_DAYS=14

# --- Logging -----------------------------------------------------------------

# Rotating log file, also tailed by the dashboard.
# LOG_FILE_ENABLED=1
# LOG_FILE=./logs/oddsiq.log
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_BACKUP_COUNT=5

# --- Tipsport ----------------------------------------------------------------

# Timeout in seconds for the initial Cloudflare challenge in the headless browser.
# CF_SOLVE_TIMEOUT=30.0

# --- Docker Compose ----------------------------------------------------------

# Image names; set to a registry path to pull prebuilt images.
# ODDSIQ_IMAGE=oddsiq
# ODDSIQ_CHROME_IMAGE=oddsiq-chrome
# Image tag to run (a version or git sha).
# ODDSIQ_TAG=latest
